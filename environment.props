<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<!-- Needs to be your path to the base Valheim folder -->
		<VALHEIM_INSTALL Condition="!Exists('$(VALHEIM_INSTALL)')">D:\SteamLibrary\steamapps\common\Valheim</VALHEIM_INSTALL>

		<!-- BepInEx path for the target profile -->
		<BEPINEX_PATH>$(AppData)\com.kesomannen.gale\valheim\profiles\main\BepInEx</BEPINEX_PATH>

		<!-- Valheim managed assemblies -->
		<VALHEIM_MANAGED>$(VALHEIM_INSTALL)\valheim_Data\Managed</VALHEIM_MANAGED>

		<!-- Deploy paths -->
		<r2ModManPath>$(AppData)\com.kesomannen.gale\valheim\profiles</r2ModManPath>
		<BepInExPath>$(r2ModManPath)\main\BepInEx</BepInExPath>
		<MOD_DEPLOYPATH>$(r2ModManPath)\main\BepInEx\plugins</MOD_DEPLOYPATH>
		<SERVER_DEPLOYPATH>$(VALHEIM_SERVER)\BepInEx\plugins</SERVER_DEPLOYPATH>

		<CopyToServer>true</CopyToServer>
	</PropertyGroup>
</Project>
